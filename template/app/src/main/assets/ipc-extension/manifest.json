{
  "manifest_version": 2,
  "name": "Tauri IPC Bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "tauri-ipc@codeserver",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent"
  ]
}
