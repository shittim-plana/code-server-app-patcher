{
    "manifest_version": 2,
    "name": "Code Server Mobile Patch",
    "version": "1.1",
    "description": "Monaco Editor mobile compatibility patches",
    "browser_specific_settings": {
        "gecko": {
            "id": "mobile-patch@codeserver",
            "strict_min_version": "128.0"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}
